diff --git a/app/Http/Controllers/MediaCoverController.php b/app/Http/Controllers/MediaCoverController.php
new file mode 100644
index 0000000..72bfeb3
--- /dev/null
+++ b/app/Http/Controllers/MediaCoverController.php
@@ -0,0 +1,23 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers;
+
+use App\Actions\Media\StoreReelCover;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Uploads an own reel cover (patch reel-cover-image): the composer's Capa tab
+ * and the REST api both answer `{ url }`, the value of a video's meta.cover_url.
+ */
+class MediaCoverController extends Controller
+{
+    public function __invoke(Request $request): JsonResponse
+    {
+        $request->validate(['cover' => ['required', 'image', 'mimes:jpeg,png,webp', 'max:20480']]);
+
+        return response()->json(['url' => StoreReelCover::execute($request->file('cover'))], 201);
+    }
+}
