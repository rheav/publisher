diff --git a/tests/Feature/Media/ReelCoverUrlTest.php b/tests/Feature/Media/ReelCoverUrlTest.php
new file mode 100644
index 0000000..be47575
--- /dev/null
+++ b/tests/Feature/Media/ReelCoverUrlTest.php
@@ -0,0 +1,130 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Dto\MediaItem;
+use App\Enums\Post\Status;
+use App\Enums\PostPlatform\ContentType;
+use App\Mcp\Servers\TryPostServer;
+use App\Mcp\Tools\Post\UpdatePostTool;
+use App\Models\Media;
+use App\Models\Post;
+use App\Models\SocialAccount;
+use App\Models\User;
+use App\Models\Workspace;
+use Illuminate\Support\Facades\Queue;
+use Illuminate\Support\Facades\Storage;
+
+// An own cover image for a reel (patch reel-cover-image): `meta.cover_url` on the video, only an address of this
+// app's `covers/` folder.
+
+beforeEach(function () {
+    Storage::fake();
+    Queue::fake();
+
+    $this->user = User::factory()->create();
+    $this->workspace = Workspace::factory()->create(['user_id' => $this->user->id]);
+    $this->workspace->members()->attach($this->user->id, membershipPivot('admin'));
+    $this->user->update(['current_workspace_id' => $this->workspace->id]);
+
+    $account = SocialAccount::factory()->instagram()->create(['workspace_id' => $this->workspace->id]);
+    $this->post = Post::factory()->forAccount($account, ContentType::InstagramReel)->create([
+        'user_id' => $this->user->id,
+        'status' => Status::Draft,
+        'scheduled_at' => null,
+    ]);
+    $this->video = Media::factory()->video()->ownedByPost($this->post)->stored()->create(['meta' => ['duration' => 10]]);
+    $this->post->update(['media' => [reelCoverItem($this->video, [])]]);
+    $this->cover = Storage::url('covers/a.jpg');
+});
+
+/**
+ * @param  array<string, mixed>  $edits
+ * @return array<string, mixed>
+ */
+function reelCoverItem(Media $video, array $edits): array
+{
+    return [
+        'id' => $video->id,
+        'path' => $video->path,
+        'url' => $video->url,
+        'type' => 'video',
+        'mime_type' => 'video/mp4',
+        'meta' => ['duration' => 10, ...$edits],
+    ];
+}
+
+/**
+ * @return array<string, string>
+ */
+function reelCoverApiHeaders(Workspace $workspace): array
+{
+    return ['Authorization' => 'Bearer '.createApiTestToken(['workspace' => $workspace])['plain_token']];
+}
+
+test('the web composer stores the cover url next to the cover frame', function () {
+    $this->actingAs($this->user)->put(route('app.posts.update', $this->post), [
+        'status' => 'draft',
+        'content' => 'hi',
+        'media' => [reelCoverItem($this->video, ['cover_offset_ms' => 1500, 'cover_url' => $this->cover])],
+    ])->assertSessionHasNoErrors();
+
+    expect($this->post->fresh()->media[0]['meta'])->toEqual(['duration' => 10, 'cover_offset_ms' => 1500, 'cover_url' => $this->cover]);
+});
+
+test('the rest api stores the cover url', function () {
+    $this->withHeaders(reelCoverApiHeaders($this->workspace))->putJson(route('api.posts.update', $this->post), [
+        'status' => 'draft',
+        'media' => [['id' => $this->video->id, 'meta' => ['cover_url' => $this->cover]]],
+    ])->assertOk();
+
+    expect(data_get($this->post->fresh()->media, '0.meta.cover_url'))->toBe($this->cover);
+});
+
+test('mcp stores the cover url', function () {
+    TryPostServer::actingAs($this->user)->tool(UpdatePostTool::class, [
+        'post_id' => $this->post->id,
+        'media' => [['id' => $this->video->id, 'meta' => ['cover_url' => $this->cover]]],
+    ])->assertHasNoErrors();
+
+    expect(data_get($this->post->fresh()->media, '0.meta.cover_url'))->toBe($this->cover);
+});
+
+test('a cover url outside this app covers folder is refused everywhere', function (string $url) {
+    $this->actingAs($this->user)->put(route('app.posts.update', $this->post), [
+        'status' => 'draft',
+        'content' => 'hi',
+        'media' => [reelCoverItem($this->video, ['cover_url' => $url])],
+    ])->assertSessionHasErrors(['media.0.meta' => 'The cover must be an image uploaded to TryPost.']);
+
+    $this->withHeaders(reelCoverApiHeaders($this->workspace))->putJson(route('api.posts.update', $this->post), [
+        'status' => 'draft',
+        'media' => [['id' => $this->video->id, 'meta' => ['cover_url' => $url]]],
+    ])->assertUnprocessable()->assertJsonValidationErrors(['media.0.meta' => 'The cover must be an image uploaded to TryPost.']);
+
+    TryPostServer::actingAs($this->user)->tool(UpdatePostTool::class, [
+        'post_id' => $this->post->id,
+        'media' => [['id' => $this->video->id, 'meta' => ['cover_url' => $url]]],
+    ])->assertHasErrors(['The cover must be an image uploaded to TryPost.']);
+
+    expect(data_get($this->post->fresh()->media, '0.meta.cover_url'))->toBeNull();
+})->with([
+    'another host' => ['https://evil.example/covers/x.jpg'],
+    'another folder of this app' => [fn () => Storage::url('medias/x.jpg')],
+    'a path walking out of covers' => [fn () => Storage::url('covers/../medias/x.jpg')],
+]);
+
+test('a duplicated post keeps the cover url', function () {
+    $this->post->update(['media' => [reelCoverItem($this->video, ['cover_url' => $this->cover])]]);
+
+    $this->actingAs($this->user)->post(route('app.posts.duplicate', $this->post))->assertRedirect();
+
+    $copy = Post::whereKeyNot($this->post->id)->sole();
+    expect(data_get($copy->media, '0.meta.cover_url'))->toBe($this->cover);
+});
+
+test('the media item reads its cover url', function () {
+    expect(MediaItem::fromArray(['meta' => ['cover_url' => '/storage/covers/a.jpg']])->coverUrl())->toBe('/storage/covers/a.jpg')
+        ->and(MediaItem::fromArray(['meta' => ['cover_url' => '']])->coverUrl())->toBeNull()
+        ->and(MediaItem::fromArray(['meta' => []])->coverUrl())->toBeNull();
+});
diff --git a/tests/Feature/Media/StoreReelCoverTest.php b/tests/Feature/Media/StoreReelCoverTest.php
new file mode 100644
index 0000000..0d7a968
--- /dev/null
+++ b/tests/Feature/Media/StoreReelCoverTest.php
@@ -0,0 +1,84 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\User;
+use App\Models\Workspace;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+
+// Uploading an own reel cover (patch reel-cover-image): a JPEG of at most 1080x1920 under covers/, its public url back.
+
+beforeEach(function () {
+    Storage::fake();
+
+    $this->user = User::factory()->create();
+    $this->workspace = Workspace::factory()->create(['user_id' => $this->user->id]);
+    $this->workspace->members()->attach($this->user->id, membershipPivot('admin'));
+    $this->user->update(['current_workspace_id' => $this->workspace->id]);
+});
+
+/**
+ * @return array{0: int, 1: int, 2: int} width, height, IMAGETYPE_*
+ */
+function storedCover(string $url): array
+{
+    $files = Storage::allFiles('covers');
+    expect($files)->toHaveCount(1)
+        ->and($files[0])->toEndWith('.jpg')
+        ->and($url)->toBe(Storage::url($files[0]));
+    [$width, $height, $type] = getimagesizefromstring(Storage::get($files[0]));
+
+    return [$width, $height, $type];
+}
+
+test('the composer uploads a cover: a big png becomes a 1080x1920 jpeg under covers/', function () {
+    $url = $this->actingAs($this->user)
+        ->postJson(route('app.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.png', 2160, 3840)])
+        ->assertCreated()->json('url');
+
+    expect(storedCover($url))->toBe([1080, 1920, IMAGETYPE_JPEG]);
+});
+
+test('a small cover is kept at its size, never upscaled', function () {
+    $url = $this->actingAs($this->user)
+        ->postJson(route('app.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.jpg', 600, 600)])
+        ->assertCreated()->json('url');
+
+    expect(storedCover($url))->toBe([600, 600, IMAGETYPE_JPEG]);
+});
+
+test('a webp cover wider than 9:16 is scaled down without cropping', function () {
+    $url = $this->actingAs($this->user)
+        ->postJson(route('app.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.webp', 3000, 1500)])
+        ->assertCreated()->json('url');
+
+    expect(storedCover($url))->toBe([1080, 540, IMAGETYPE_JPEG]);
+});
+
+test('a file that is not an image is refused', function () {
+    $this->actingAs($this->user)
+        ->postJson(route('app.media.covers.store'), ['cover' => UploadedFile::fake()->create('c.pdf', 10, 'application/pdf')])
+        ->assertUnprocessable()->assertJsonValidationErrors('cover');
+
+    expect(Storage::allFiles('covers'))->toBe([]);
+});
+
+test('a guest cannot upload a cover', function () {
+    $this->postJson(route('app.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.jpg', 100, 100)])
+        ->assertUnauthorized();
+    $this->postJson(route('api.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.jpg', 100, 100)])
+        ->assertUnauthorized();
+
+    expect(Storage::allFiles('covers'))->toBe([]);
+});
+
+test('the rest api uploads a cover with a workspace token', function () {
+    $token = createApiTestToken(['workspace' => $this->workspace])['plain_token'];
+
+    $url = $this->withHeaders(['Authorization' => "Bearer {$token}"])
+        ->postJson(route('api.media.covers.store'), ['cover' => UploadedFile::fake()->image('c.png', 1080, 1920)])
+        ->assertCreated()->json('url');
+
+    expect(storedCover($url))->toBe([1080, 1920, IMAGETYPE_JPEG]);
+});
