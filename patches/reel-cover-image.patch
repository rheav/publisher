+++ b/app/Actions/Media/StoreReelCover.php
@@ -0,0 +1,45 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Actions\Media;
+
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Intervention\Image\Drivers\Gd\Driver;
+use Intervention\Image\ImageManager;
+
+/**
+ * Stores an own reel cover (patch reel-cover-image) the way Meta takes it: a
+ * JPEG of at most 1080x1920 (scaled down, never cropped or upscaled) and 8 MB,
+ * in covers/, outside the media table, so the temporary-upload prune never
+ * deletes it before the post goes out. Returns its public url.
+ */
+class StoreReelCover
+{
+    public const int MAX_WIDTH = 1080;
+
+    public const int MAX_HEIGHT = 1920;
+
+    public const int MAX_BYTES = 8 * 1024 * 1024;
+
+    public static function execute(UploadedFile $file): string
+    {
+        $image = (new ImageManager(Driver::class))->decodePath((string) $file->getRealPath());
+        $image->scaleDown(self::MAX_WIDTH, self::MAX_HEIGHT);
+
+        // a 1080x1920 JPEG is well under 8 MB at 90; the steps down only guard a pathological image
+        for ($quality = 90; ; $quality -= 10) {
+            $jpeg = (string) $image->encodeUsingMediaType('image/jpeg', quality: $quality);
+            if (strlen($jpeg) <= self::MAX_BYTES || $quality <= 60) {
+                break;
+            }
+        }
+
+        $path = 'covers/'.Str::uuid().'.jpg';
+        Storage::put($path, $jpeg, 'public');
+
+        return Storage::url($path);
+    }
+}
